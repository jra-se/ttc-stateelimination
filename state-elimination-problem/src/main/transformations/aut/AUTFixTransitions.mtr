/* (c) https://github.com/MontiCore/monticore */

automaton $_ {
  state $cur;

  $A - $ACLabel > $cur;
  $cur - $CBLabel > $B;
  opt [[ list $LOOPS [[ $cur - $loopLabel > $cur; ]] ]]

  [[ :- $NEWT [[ $A - UNDEFINED > $B; ]] ]]
}

// No folding required for identifiers

do {
  if ($LOOPS.isPresent()) {
    m.$NEWT.setInput($ACLabel + "(" + $loopLabel_list.stream().map(lbl -> "(" + lbl + ")")
     .collect(Collectors.joining("|")) + ")*"  + $CBLabel);
  } else {
    m.$NEWT.setInput($ACLabel + $CBLabel);
  }
}